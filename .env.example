# SmartAttend Environment Variables
# Copy this file to .env and fill in your Supabase credentials

# Supabase API URL (from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (from Project Settings -> API)
# Safe to expose in client-side code with Row Level Security enabled
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Demo Mode override (true by default if Supabase keys are not set)
VITE_DEMO_MODE=true
