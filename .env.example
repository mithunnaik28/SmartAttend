# SmartAttend browser configuration
# Demo mode is opt-in and only works when Supabase credentials are absent.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/publishable key (safe to expose with correct RLS policies)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set true only for local/demo previews without a database
VITE_DEMO_MODE=false
